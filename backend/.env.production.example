# Plantilla de .env para produccion (Hostinger). NO contiene secretos.
# Completa los campos marcados "COMPLETAR" y subi el resultado como .env
# en el hosting (nunca commitees el .env real al repo).

APP_NAME=CineConcordia
APP_ENV=production
# Generar uno NUEVO para produccion, no reusar el de desarrollo local:
#   php artisan key:generate --show
APP_KEY=COMPLETAR_clave_generada_con_artisan_key_generate
APP_DEBUG=false
# Dominio real asignado en Hostinger (con https):
APP_URL=COMPLETAR_https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En produccion, no "debug":
LOG_LEVEL=error

# Estos 5 salen del panel de MySQL de Hostinger (hPanel > Bases de datos),
# no son los de tu XAMPP local:
DB_CONNECTION=mysql
DB_HOST=COMPLETAR_host_mysql_hostinger
DB_PORT=3306
DB_DATABASE=COMPLETAR_nombre_db_hostinger
DB_USERNAME=COMPLETAR_usuario_db_hostinger
DB_PASSWORD=COMPLETAR_password_db_hostinger

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Tu dominio, sin protocolo (ej: tu-dominio.com):
SESSION_DOMAIN=COMPLETAR_tu-dominio.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Completar solo si vas a enviar emails reales desde la app:
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=COMPLETAR_si_usas_mail
MAIL_PORT=587
MAIL_USERNAME=COMPLETAR_si_usas_mail
MAIL_PASSWORD=COMPLETAR_si_usas_mail
MAIL_FROM_ADDRESS=COMPLETAR_si_usas_mail
MAIL_FROM_NAME="${APP_NAME}"

# Dejar vacio si no usas AWS S3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Client ID de OAuth de Google (no es secreto, va embebido en el frontend).
# Mismo valor que en local; cargalo tambien como variable de entorno en Railway.
GOOGLE_CLIENT_ID=303445118007-ldr48kf6mm487cdi5f7h5vdeal9to7ap.apps.googleusercontent.com

VITE_APP_NAME="${APP_NAME}"
