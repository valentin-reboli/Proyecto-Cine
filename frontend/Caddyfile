{
	admin off
	auto_https off
	servers {
		# Railway termina el HTTPS antes de llegar aca; se respeta su X-Forwarded-Proto.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode gzip

	# La API vive en otro servicio (o en el mismo contenedor); BACKEND_URL es su URL.
	@backend path /api/* /docs /docs/*
	handle @backend {
		reverse_proxy {$BACKEND_URL} {
			header_up Host {upstream_hostport}
		}
	}

	# Angular: cualquier ruta que no sea un archivo (/reserva, /admin, ...) carga index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
